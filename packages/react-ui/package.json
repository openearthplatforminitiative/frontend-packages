{
  "name": "@openepi/react-ui",
  "version": "1.0.0",
  "description": "Responsive and accessible React UI components built with React, Ark UI and Panda",
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsx ../../scripts/build/main.ts --dts",
    "build:fast": "tsx ../../scripts/build/main.ts",
    "dev": "npm run build:fast -- --watch",
    "prepare": "panda codegen"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@ark-ui/react": "^4",
    "@openepi/icons": "*",
    "@zag-js/anatomy": "^0",
    "@pandacss/dev": "^0",
    "lodash": "^4"
  },
  "devDependencies": {
    "@types/lodash": "^4"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./preset": {
      "source": "./src/preset.ts",
      "import": {
        "types": "./dist/types/preset.d.ts",
        "default": "./dist/esm/preset.js"
      },
      "require": {
        "types": "./dist/types/preset.d.ts",
        "default": "./dist/cjs/preset.cjs"
      }
    },
    "./styled-system/*": {
      "source": "./src/styled-system/*.ts",
      "import": {
        "types": "./dist/types/styled-system/*.d.ts",
        "default": "./dist/esm/styled-system/*.js"
      },
      "require": {
        "types": "./dist/types/styled-system/*.d.ts",
        "default": "./dist/cjs/styled-system/*.cjs"
      }
    },
    "./*": {
      "source": "./src/components/*.ts",
      "import": {
        "types": "./dist/types/components/*.d.ts",
        "default": "./dist/esm/components/*.js"
      },
      "require": {
        "types": "./dist/types/components/*.d.ts",
        "default": "./dist/cjs/components/*.cjs"
      }
    }
  }
}