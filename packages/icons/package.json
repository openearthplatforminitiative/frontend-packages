{
  "name": "@openepi/icons",
  "version": "1.0.0",
  "description": "Material symbols available as React components",
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsx ../../scripts/build/main.ts --dts",
    "build:fast": "tsx ../../scripts/build/main.ts",
    "dev": "npm run build:fast -- --watch",
    "generate-icons": "node scripts/generate-icons.mjs",
    "generate-types": "node scripts/generate-svg-types.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@svgr/cli": "^8.1.0",
    "@material-symbols/svg-400": "0.27.1"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  }
}